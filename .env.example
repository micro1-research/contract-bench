# Copy to .env and fill in the keys you need. Never commit .env.

# Model providers (set the ones whose models you run)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Judge panel for grading: ANTHROPIC_API_KEY is required; OPENAI_API_KEY and GEMINI_API_KEY complete the
# three-judge panel (a missing member is dropped from the vote and the grade is flagged as degraded).

# Optional
CONTRACTBENCH_DIR=        # dataset location (default: ./benchmark)
DOCKER_HOST=              # for example unix://$HOME/.colima/default/docker.sock (Colima)
HARBOR_BIN=               # default: `harbor` on PATH
